# Create a data frame with a sequence of t values
d <- data.frame(t = seq(0, 10, 0.1))
# Define a quadratic function for a concave PPF
a <- 10  # Maximum possible output of good Y
b <- 0.5 # Parameter to control the curvature
# Calculate the corresponding Y values, assuming X is being produced
d$Y <- a - b * d$t^2
# Plot the concave function
plot(d$t, d$Y, type='l', main="Concave Curve: Production Possibility Frontier",
xlab="Good X", ylab="Good Y")
# Calculate the corresponding Y values, assuming X is being produced
d$Y <- a - b * d$t^1.2
# Plot the concave function
plot(d$t, d$Y, type='l', main="Concave Curve: Production Possibility Frontier",
xlab="Good X", ylab="Good Y")
b <- 0.8 # Parameter to control the curvature
# Calculate the corresponding Y values, assuming X is being produced
d$Y <- a - b * d$t^2
# Plot the concave function
plot(d$t, d$Y, type='l', main="Concave Curve: Production Possibility Frontier",
xlab="Good X", ylab="Good Y")
# Define a quadratic function for a concave PPF
a <- 10  # Maximum possible output of good Y
b <- 0.2 # Parameter to control the curvature
# Calculate the corresponding Y values, assuming X is being produced
d$Y <- a - b * d$t^2
# Plot the concave function
plot(d$t, d$Y, type='l', main="Concave Curve: Production Possibility Frontier",
xlab="Good X", ylab="Good Y")

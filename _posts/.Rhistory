penalty <- sleep_weight * (max(8 - x[3], 0)^2)  # Penalize only if x[3] < 8
return(- x[1]^a * x[2]^b + penalty)
}
#
# sleep is in the utility function #
fn <- function(x, a, b, wage, sleep_weight) {
return(- x[1]^a * x[2]^b + x[3]^sleep_weight)
}
# Updated Constraints Function
constraints <- function(x, a, b, wage, sleep_weight) {
return(
c(
- wage * x[1] + 60,          # wage * working hours >= 60
x[3] - 6,                 # sleep >= 8
x[1] + x[2] + x[3] - 24,  # total hours <= 24
-x[1] - x[2] - x[3] + 24  # total hours >= 24
)
)
}
# Solving with Updated Utility Function
result <- nloptr::nloptr(
x0 = c(8, 8, 8),  # Initial guess assuming (work hours, leisure, sleep)
eval_f = fn,
eval_g_ineq = constraints,
lb = c(0, 0, 8),  # Lower bounds (work hours, leisure, sleep >= 8)
ub = c(24, 24, 24),  # Upper bounds (finite time resources)
opts = list("algorithm" = "NLOPT_LN_COBYLA", "xtol_rel" = 1e-4),
a = 0.3,
b = 0.2,
wage = 10,
sleep_weight = 0.5  # Weight for sleep penalty
)
# View the result
print(result$solution)
#
# Utility Function
utility <- function(x, a, b, c, w, p, alpha) {
T_w <- x[1]  # Time working in the market
T_h <- x[2]  # Time in household production
L <- x[3]    # Leisure
S <- x[4]    # Sleep
# Consumption from market and household production
C_m <- w * T_w
C_h <- p * T_h^alpha
# Total utility
return(- ((C_m + C_h)^a * L^b * S^c))  # Negative because nloptr minimizes
}
# Constraints
constraints <- function(x) {
T_w <- x[1]
T_h <- x[2]
L <- x[3]
S <- x[4]
return(c(
T_w + T_h + L + S - 24,  # Time constraint
S - 8,                   # Minimum sleep
-T_w,                    # Non-negativity for T_w
-T_h,                    # Non-negativity for T_h
-L,                      # Non-negativity for L
-S                       # Non-negativity for S
))
}
# Optimization
result <- nloptr::nloptr(
x0 = c(8, 8, 4, 4),  # Initial guess: (T_w, T_h, L, S)
eval_f = utility,
eval_g_ineq = constraints,
lb = c(0, 0, 0, 8),  # Lower bounds
ub = c(24, 24, 24, 24),  # Upper bounds
opts = list("algorithm" = "NLOPT_LN_COBYLA", "xtol_rel" = 1e-4),
a = 0.5,
b = 0.3,
c = 0.2,
w = 10,      # Wage rate (market productivity)
p = 5,       # Household productivity
alpha = 0.8  # Diminishing returns in household production
)
# View solution
print(result$solution)
